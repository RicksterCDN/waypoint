# Foundry project endpoint for local development.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# Name of a model deployment that exists in the Foundry project.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5-mini

# Optional: enables OpenTelemetry traces for local development.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Optional: default per-run max_runtime budget in minutes (default 30). Applies
# only when a request omits constraints.max_runtime_minutes; an explicit request
# value always wins. Invalid/non-positive values fall back to 30. Keep this
# comfortably below the Waypoint stale-run reaper TTL (APP_RUN_REAPER_TTL_SECONDS,
# prod default 2700s/45m) so progressing runs are not false-reaped.
ASSURANCE_ORCHESTRATOR_MAX_RUNTIME_MINUTES=30

# Optional: read-only Waypoint API integration testing.
# Leave WAYPOINT_API_SCOPE empty for local Aspire loopback dev auth.
# WAYPOINT_API_BASE_URL=https://localhost:<waypoint-api-port>
# WAYPOINT_API_SCOPE=
# Set false only for local Aspire HTTPS with a self-signed dev certificate.
WAYPOINT_API_VERIFY_SSL=false

# Optional: Content Understanding PDF extraction. The endpoint is the AI
# Services account endpoint, not the Foundry project endpoint.
CONTENT_UNDERSTANDING_ENDPOINT=https://<account>.services.ai.azure.com
CONTENT_UNDERSTANDING_API_VERSION=2025-11-01
CONTENT_UNDERSTANDING_ANALYZER_ID=prebuilt-invoice
CONTENT_UNDERSTANDING_SCOPE=https://cognitiveservices.azure.com/.default

# Optional: make Pipeline Mission Control launch real local experts with their
# implemented tools instead of the fast deterministic stub host.
PIPELINE_IQ_MODE=hosted

# Optional: route Assurance Orchestrator workflow fan-out through Foundry prompt-agent experts
# instead of hosted expert Responses endpoints. Agent-name overrides are useful
# while live prompt canaries exist beside hosted rollback agents.
ASSURANCE_ORCHESTRATOR_EXPERT_INVOCATION_MODE=prompt
ASSURANCE_ORCHESTRATOR_EXPERT_PROJECT_ENDPOINT=${FOUNDRY_PROJECT_ENDPOINT}
ASSURANCE_ORCHESTRATOR_EXPERT_MODEL=${AZURE_AI_MODEL_DEPLOYMENT_NAME}
COLLABORATION_EVIDENCE_EXPERT_AGENT_NAME=collaboration-evidence-expert
MARKET_EVIDENCE_EXPERT_AGENT_NAME=market-evidence-expert
CONTRACT_POLICY_EXPERT_AGENT_NAME=contract-policy-expert
OPERATIONS_DATA_EXPERT_AGENT_NAME=operations-data-expert
